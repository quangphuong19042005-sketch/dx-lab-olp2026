# ============================================================================
# DX-Lab OSS — Mẫu cấu hình môi trường
# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG commit file `.env`.
# ============================================================================

# --- Chung ---
DXLAB_DOMAIN=localhost
TZ=Asia/Ho_Chi_Minh

# --- [D] PostgreSQL — Nguồn sự thật duy nhất (SSOT) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dxlab
POSTGRES_USER=dxlab
POSTGRES_PASSWORD=change_me_strong_password

# --- [H] Keycloak — Định danh tập trung (SSO / OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_admin_password
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=dxlab
OIDC_CLIENT_ID=dx-portal
OIDC_CLIENT_SECRET=change_me_client_secret

# --- [P] Baserow — Low-code DB / Form ---
BASEROW_PORT=8085

# --- [P] Node-RED — Tự động hóa luồng (automation / iPaaS) ---
NODERED_PORT=1880

# --- [D] Metabase — BI Dashboard ---
METABASE_PORT=3001

# --- [H] Rocket.Chat + Telegram — Giao tiếp & cảnh báo ---
ROCKETCHAT_PORT=3002
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- [I] AI — RAG / Agent ---
# Chế độ LLM: "local" (Ollama) hoặc "api" (dịch vụ ngoài). Xem docs/du-an.md §6.1.
LLM_MODE=local
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# Khi LLM_MODE=api thì điền khóa dịch vụ ngoài (tùy chọn nhà cung cấp)
LLM_API_BASE=
LLM_API_KEY=
QDRANT_HOST=http://qdrant:6333

# --- Service tự viết ---
DX_CORE_PORT=8000
DX_PORTAL_PORT=3000
DX_DIAG_PORT=3003
DX_RAG_PORT=8001

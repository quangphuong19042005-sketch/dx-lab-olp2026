# ============================================================================
# DX-Lab OSS — Mẫu cấu hình môi trường
# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG commit file `.env`.
# ============================================================================

# --- Chung ---
DXLAB_DOMAIN=localhost
TZ=Asia/Ho_Chi_Minh

# --- [D] PostgreSQL — Nguồn sự thật duy nhất (SSOT) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dxlab
POSTGRES_USER=dxlab
POSTGRES_PASSWORD=change_me_strong_password

# --- [H] Keycloak — Định danh tập trung (SSO / OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_admin_password
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=dxlab
# (Client ID/secret cho SSO xem mục "SSO cho DX-Portal" bên dưới: KEYCLOAK_ID/KEYCLOAK_SECRET)

# --- [H] Nextcloud — Lưu trữ tài liệu P.A.R.A ---
NEXTCLOUD_PORT=8090
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_nextcloud_admin
# Đường dẫn kho tri thức [R]esources để DX-RAG nạp (WebDAV)
NEXTCLOUD_KNOWLEDGE_PATH=DX-Lab/3-Resources

# --- [P] Baserow — Low-code DB / Form ---
BASEROW_PORT=8085

# --- [P] Node-RED — Tự động hóa luồng (automation / iPaaS) ---
NODERED_PORT=1880

# --- [D] Metabase — BI Dashboard ---
METABASE_PORT=3001
MB_ADMIN_EMAIL=admin@dxlab.local
MB_ADMIN_PASSWORD=change_me_metabase_admin

# --- [H] Rocket.Chat + Telegram — Giao tiếp & cảnh báo ---
ROCKETCHAT_PORT=3002
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- [I] AI — RAG / Agent ---
# Chế độ LLM: "api" (Gemini, mặc định — nhẹ máy) hoặc "local" (Ollama, offline).
LLM_MODE=api

# Hướng API (Google Gemini). ĐIỀN KEY TRONG .env, KHÔNG commit.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Hướng cục bộ (Ollama) — dùng khi LLM_MODE=local
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cơ sở dữ liệu véc-tơ
QDRANT_HOST=http://qdrant:6333

# --- SSO cho DX-Portal (next-auth ↔ Keycloak OIDC) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=thay_bang_chuoi_ngau_nhien   # sinh: openssl rand -base64 32
KEYCLOAK_ID=dx-portal
KEYCLOAK_SECRET=dxlab-portal-secret-2026
KEYCLOAK_ISSUER=http://localhost:8080/realms/dxlab
KEYCLOAK_WELLKNOWN=http://keycloak:8080/realms/dxlab/.well-known/openid-configuration

# --- Service tự viết ---
DX_CORE_PORT=8000
DX_PORTAL_PORT=3000
DX_DIAG_PORT=3003
DX_RAG_PORT=8001
